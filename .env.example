# Copiez ce fichier en .env.local pour le développement local.
# Sur Vercel : Project Settings > Environment Variables.

# Clé API Anthropic pour le chatbot (obligatoire pour des réponses générées par l'IA).
# Sans cette clé, le chatbot répond quand même avec des réponses prédéfinies (mode de secours).
ANTHROPIC_API_KEY=

# Modèle utilisé par le chatbot (optionnel).
ANTHROPIC_MODEL=claude-haiku-5-5

# Alternative gratuite en local : un modèle Ollama (https://ollama.com).
# Utilisé seulement si ANTHROPIC_API_KEY est vide ou en échec.
# Exemple : ollama pull llama3.2, puis OLLAMA_MODEL=llama3.2
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434

# Nombre maximum de questions par visiteur toutes les 10 minutes (optionnel).
CHAT_RATE_LIMIT=30
